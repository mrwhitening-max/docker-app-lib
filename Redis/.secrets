# ============================================
# REDIS AGENT MEMORY CONFIGURATION
# ============================================

# ============================================
# REDIS CONFIGURATION
# ============================================
# Passwort fuer Redis-Zugriff
# Generieren mit: openssl rand -base64 32
REDIS_PASSWORD=

# Redis Service Name in Consul
REDIS_SERVICE_NAME=redis

# Redis Port
REDIS_PORT=6379

# Redis Image Version
REDIS_VERSION=7-alpine

# Append-Only-File Persistenz (yes = Daten ueberleben Neustart)
REDIS_APPENDONLY=yes

# ============================================
# CONSUL CONFIGURATION
# ============================================
# Version des Consul Docker Images
CONSUL_VERSION=1.22.3

# Consul Server IP
# Beispiel: 192.168.2.20
CONSUL_SERVER_IP=

# Eindeutiger Node Name fuer diesen LXC
CONSUL_NODE_NAME=lxc-redis

# Datacenter Name (identisch auf allen Nodes)
CONSUL_DATACENTER=homelab

# Log Level
# Optionen: TRACE, DEBUG, INFO, WARN, ERROR
CONSUL_LOG_LEVEL=INFO

# Netzwerk-Interface
NETWORK_INTERFACE=eth0

# ============================================
# GOSSIP ENCRYPTION
# ============================================
# Symmetrischer Verschluesselungsschluessel fuer Gossip Traffic
# Vom Consul Server kopieren - MUSS auf allen Nodes identisch sein!
CONSUL_GOSSIP_KEY=

# ============================================
# RPC TLS
# ============================================
# CA Public Key als Base64
# Vom Consul Server kopieren:
#   docker exec consul-server base64 /consul-agent-ca.pem | tr -d '\n'
# Nur der Public Key - identisch auf allen Agent Nodes
# Kein eigenes Cert generieren! auto_encrypt holt den Rest automatisch.
CONSUL_CA_CERT_B64=